[Unit]
Description=gitbombando — retrato das estrelas dos projetos em alta (curva dos gráficos)
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/projetos/gitbombando/coleta/retrato.py
TimeoutStartSec=20min
MemoryMax=2G
Nice=10
